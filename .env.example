# Email Notification Automation - Environment Variables

# Email Provider (gmail or outlook)
EMAIL_PROVIDER=gmail

# Gmail OAuth2 Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_FROM=your-email@gmail.com

# Outlook/Microsoft 365 OAuth2 Configuration
OUTLOOK_USER=your-email@outlook.com
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REFRESH_TOKEN=your-outlook-refresh-token
OUTLOOK_TENANT_ID=your-tenant-id
OUTLOOK_SMTP_HOST=smtp.office365.com
OUTLOOK_SMTP_PORT=587
OUTLOOK_FROM=your-email@outlook.com

# App URL for job links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend transactional email (server-only)
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=me@example.com

# Cron secret protecting /api/cron/triggers
CRON_SECRET=your-long-random-secret
