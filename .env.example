# ─────────────────────────────────────────────────────────────────────────────
# Resend (sole email provider). All sending goes through the official
# Resend SDK; inbound email is handled by POST /api/webhooks/resend.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
# Signing secret for Resend inbound webhooks (Resend dashboard > Webhooks).
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret
# Verified "from" address used by the Resend provider.
EMAIL_FROM="Power Weave Studio <hello@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────────────────
# App URL for job links / reset links
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Cron secret protecting /api/cron/triggers and /api/test-email
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET=your-long-random-secret

# ─────────────────────────────────────────────────────────────────────────────
# Recipient routing (env-driven; resolved in src/lib/email/routing.ts)
# ─────────────────────────────────────────────────────────────────────────────
OWNER_EMAIL=rujutapethe@gmail.com
NOTIFY_EMAIL=me@example.com

# ─────────────────────────────────────────────────────────────────────────────
# Overdue job & invoice-clearance digest alerts (src/features/email-alerts)
# ─────────────────────────────────────────────────────────────────────────────
# Organization id(s) to check, comma separated. When unset, the owner's
# organizations are resolved from OWNER_EMAIL.
ALERT_ORGANIZATION_ID=
# Reminder cadence in days: alert on the first overdue day, then repeat.
ALERT_REPEAT_INTERVAL_DAYS=7
# "true" = detect and render only; nothing is sent and no log rows are written.
ALERTS_DRY_RUN=false
# Redirect every digest to this address while testing. Logs still record the
# original recipients, so production delivery resumes when this is unset.
EMAIL_OVERRIDE_TO=
# "1" logs the alert columns resolved per board. Diagnostics only.
ALERTS_DEBUG=
